; The light a level is shown in on the card. Its own world -- sky, haze, ambient
; -- is stripped out with the rest of the play, so without this the stage would
; be lit by its sun alone and every shadow would be black. No sky on purpose:
; the viewport is transparent, and the page shows through where the level is not.
[sub_resource type="Environment" id="Environment_preview"]
background_mode = 0
ambient_light_source = 1
ambient_light_color = Color(1, 1, 1, 1)
ambient_light_energy = 0.6
reflected_light_source = 1

