; The two tabs over the start button. A tab is a toggle: the one that is on
; draws its own colour -- the same green or gold as the button under it -- and
; the one that is off draws the dark face with its colour left in the text, so
; the pair still reads as "green here, gold there" at a glance.
;
; Square along the bottom, so an on tab runs into the button below it rather than
; floating over it.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_tab_idle"]
bg_color = Color(0.16078432, 0.1764706, 0.19215687, 1)
corner_radius_top_left = 24
corner_radius_top_right = 24

