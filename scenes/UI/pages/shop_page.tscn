; again a moment later.
[node name="Note" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.9, 0.75, 0.35, 1)
theme_override_font_sizes/font_size = 36
text = "Not on sale yet"
horizontal_alignment = 1

; What is left over goes below it all.
[node name="Filler" type="Control" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

; One slot, cloned three times. The whole tile is the button: a marble, its name
; and what it costs, all of it pressable.
[node name="SlotTemplate" type="Button" parent="."]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 510)
layout_mode = 1
anchors_preset = 0
offset_right = 300.0
offset_bottom = 510.0
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_styles/normal = SubResource("StyleBoxFlat_tile")
theme_override_styles/hover = SubResource("StyleBoxFlat_tile")
theme_override_styles/pressed = SubResource("StyleBoxFlat_tile_pressed")
theme_override_styles/disabled = SubResource("StyleBoxFlat_tile_off")
theme_override_styles/focus = SubResource("StyleBoxEmpty_focus")

; Centred, because the tile is taller than what is in it and content pinned to
; the top of a tall tile reads as a mistake.
[node name="Stack" type="VBoxContainer" parent="SlotTemplate"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 22
alignment = 1

; Square, and neither stretched nor squashed by the tile it sits in. The camera
; inside frames a ball, and a ball in a tall thin window is a ball with its sides
; cut off.
[node name="View" type="SubViewportContainer" parent="SlotTemplate/Stack"]
custom_minimum_size = Vector2(290, 290)
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
mouse_filter = 2
stretch = true

[node name="SubViewport" type="SubViewport" parent="SlotTemplate/Stack/View"]
own_world_3d = true
transparent_bg = true
handle_input_locally = false
size = Vector2i(290, 290)
render_target_update_mode = 3

[node name="WorldEnvironment" type="WorldEnvironment" parent="SlotTemplate/Stack/View/SubViewport"]
environment = SubResource("Environment_shop")

[node name="Camera3D" type="Camera3D" parent="SlotTemplate/Stack/View/SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 2.2)
projection = 1
size = 1.25

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="SlotTemplate/Stack/View/SubViewport"]
transform = Transform3D(0.8660254, -0.25, 0.4330127, 0, 0.8660254, 0.5, -0.5, -0.4330127, 0.75, 0, 0, 0)

; The material here is only what shows in the editor; the page puts whatever is
; on sale onto it -- see shop_page.gd.
[node name="Marble" type="MeshInstance3D" parent="SlotTemplate/Stack/View/SubViewport"]
mesh = SubResource("SphereMesh_shop")
surface_material_override/0 = ExtResource("2_marble")

[node name="SkinName" type="Label" parent="SlotTemplate/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 48
text = "Marble"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Price" type="Label" parent="SlotTemplate/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.63529414, 0.6784314, 0.6509804, 1)
theme_override_font_sizes/font_size = 56
text = "750"
horizontal_alignment = 1
