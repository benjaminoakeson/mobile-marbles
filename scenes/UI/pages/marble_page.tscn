[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_marble"]
sky_horizon_color = Color(0.66224277, 0.6717428, 0.6867428, 1)
ground_horizon_color = Color(0.66224277, 0.6717428, 0.6867428, 1)

[sub_resource type="Sky" id="Sky_marble"]
sky_material = SubResource("ProceduralSkyMaterial_marble")

[sub_resource type="Environment" id="Environment_marble"]
sky = SubResource("Sky_marble")
ambient_light_source = 3
reflected_light_source = 2

[sub_resource type="SphereMesh" id="SphereMesh_marble"]

; A tile is painted with its own skin's colour at build time, so the styleboxes
; here only carry the shape. The colours in them are what an unrecognised skin
; would fall back to and are never normally seen.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_skin"]
bg_color = Color(0.20392157, 0.22745098, 0.25490196, 1)
corner_radius_top_left = 28
corner_radius_top_right = 28
corner_radius_bottom_right = 28
corner_radius_bottom_left = 28

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_focus"]

[node name="MarblePage" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("4_page")

[node name="Title" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 60.0
offset_bottom = 180.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 86
text = "YOUR MARBLE"
horizontal_alignment = 1

; Smaller than it was: the picker below it now wants the bottom half of the
; page, and the marble still reads at this size on a phone.
[node name="MarbleView" type="SubViewportContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 240.0
offset_top = 200.0
offset_right = -240.0
offset_bottom = 800.0
grow_horizontal = 2
mouse_filter = 2
stretch = true

[node name="SubViewport" type="SubViewport" parent="MarbleView"]
own_world_3d = true
transparent_bg = true
handle_input_locally = false
size = Vector2i(600, 600)
render_target_update_mode = 3

[node name="WorldEnvironment" type="WorldEnvironment" parent="MarbleView/SubViewport"]
environment = SubResource("Environment_marble")

[node name="Camera3D" type="Camera3D" parent="MarbleView/SubViewport"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 2.2)
fov = 40.0

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="MarbleView/SubViewport"]
