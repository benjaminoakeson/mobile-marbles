[gd_scene format=3]

[ext_resource type="Script" uid="uid://jp8kmqb6wji0" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/time_ring.gd" id="2_time_ring"]
[ext_resource type="PackedScene" path="res://scenes/UI/camera_control.tscn" id="3_camera_control"]
[ext_resource type="PackedScene" path="res://scenes/UI/radial_menu.tscn" id="4_radial_menu"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 28.0
content_margin_top = 12.0
content_margin_right = 28.0
content_margin_bottom = 16.0
bg_color = Color(0.09019608, 0.10980392, 0.12941177, 0.54901963)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

; The corner radius is half the circle's 300px box, which is what rounds it all
; the way off. Change one and the other has to follow.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_circle"]
bg_color = Color(0.09019608, 0.10980392, 0.12941177, 0.61176471)
corner_radius_top_left = 150
corner_radius_top_right = 150
corner_radius_bottom_right = 150
corner_radius_bottom_left = 150

[node name="Hud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_hud")

; --- Top left: the lives, and how the run is climbing towards another one ---
[node name="TopLeft" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 0
offset_left = 48.0
offset_top = 60.0
offset_right = 648.0
offset_bottom = 320.0
mouse_filter = 2
theme_override_constants/separation = 18

; A plain Control, not a container: the marbles overlap, and every container
; Godot has would space them apart instead. The script places them by hand.
[node name="Lives" type="Control" parent="TopLeft"]
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 88)
layout_mode = 2
mouse_filter = 2

; Play mode shows nothing here. The corner is simply empty.

; Hidden in play mode along with the marbles: there is no next life to climb
; towards when there is no life to lose.
[node name="NextLifeRow" type="HBoxContainer" parent="TopLeft"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="NextLifePanel" type="PanelContainer" parent="TopLeft/NextLifeRow"]
layout_mode = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Stack" type="VBoxContainer" parent="TopLeft/NextLifeRow/NextLifePanel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="NextLifeName" type="Label" parent="TopLeft/NextLifeRow/NextLifePanel/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.63529414, 0.6784314, 0.6509804, 1)
theme_override_font_sizes/font_size = 30
text = "NEXT LIFE"

[node name="NextLifeValue" type="Label" parent="TopLeft/NextLifeRow/NextLifePanel/Stack"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 40
text = "0 / 20"

; --- The buzzer: what the level says once the clock has run out ---
; Under the clock it belongs to, and clear of it -- the clock's circle ends at
; y360. Carries its own outline for the same reason the victory title does: there
; is no dimming behind it, and the level is still moving underneath.
;
; It stays up while the ball coasts, and comes down only if that coast reaches
; the goal -- see `_on_level_finished()`.
[node name="TimeOut" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 400.0
offset_bottom = 540.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.94509804, 0.32941177, 0.32941177, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/outline_size = 18
theme_override_font_sizes/font_size = 104
text = "TIME OUT"
horizontal_alignment = 1

; --- The fall: what the level says while it waits to be taken again ---
; Centred and low, clear of the clock above and of wherever the thumb last was.
; It is a Label and not a button: the tap is taken as unhandled input, so it
; counts anywhere on the screen rather than only on these words.
[node name="FallPrompt" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -400.0
offset_top = -420.0
offset_right = 400.0
offset_bottom = -300.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 56
text = "TAP TO TRY AGAIN"
horizontal_alignment = 1
vertical_alignment = 1

; --- Top centre: the clock, the one number the player watches while playing ---
; A plain Panel, NOT a PanelContainer. A container clamps itself to its
; children's minimum size, and the clock's own label is what sets that: the
; circle stretched into a wider and wider pill every time the time gained a
; digit -- once at ten seconds, again at a minute. Nothing about the box may
; depend on the text, so the box is placed by hand and the children are anchored
; inside it.
[node name="TimeCircle" type="Panel" parent="."]
custom_minimum_size = Vector2(300, 300)
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -150.0
offset_top = 60.0
offset_right = 150.0
offset_bottom = 360.0
grow_horizontal = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_circle")

; Traces the rim of the circle above, and is listed before the numbers so those
; always draw over it.
[node name="TimeRing" type="Control" parent="TimeCircle"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_time_ring")

[node name="Stack" type="VBoxContainer" parent="TimeCircle"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 0
alignment = 1

[node name="TimeName" type="Label" parent="TimeCircle/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.63529414, 0.6784314, 0.6509804, 1)
theme_override_font_sizes/font_size = 30
text = "TIME"
horizontal_alignment = 1

[node name="TimeValue" type="Label" parent="TimeCircle/Stack"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 60
text = "0.00s"
horizontal_alignment = 1

; --- Camera: drags above the stick swing the view, and the button in the corner
; hands it back to the automatic shot. Lives on the HUD rather than in each
; level so no level can be built without it.
[node name="CameraControl" parent="." instance=ExtResource("3_camera_control")]

; --- Bottom centre: the quick menu. A disc that lives mostly off the bottom edge
; of the screen and rises out of it -- the stick swap, and the way out of the
; level, both without leaving it.
;
; This is where the corner stick-swap button went. That button's argument was
; that the stick has to be swappable mid-roll, and this keeps it: the swap is
; still on screen during play, still swaps under the rolling ball, and is now two
; taps rather than one. Bottom CENTRE rather than a corner, so unlike the camera
; reset opposite it, it needs no handedness -- there is no near side to a middle.
[node name="RadialMenu" parent="." instance=ExtResource("4_radial_menu")]
