; No dimming behind this any more, so the title carries its own outline --
; otherwise it disappears the moment the marble drifts across it.
[node name="Title" type="Label" parent="Panel"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 300.0
offset_bottom = 620.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/outline_size = 18
theme_override_font_sizes/font_size = 104
text = "LEVEL
COMPLETE"
horizontal_alignment = 1

; --- The tally: a running total, and one chip at a time flying into it ---

; Scaled by the script as it counts, so its pivot has to sit in the middle. The
; label spans the full width and centres its text, which keeps that pivot on the
; screen's centre line however many digits the number grows to.
[node name="TotalValue" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 700.0
offset_bottom = 860.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.94901961, 0.72156863, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/outline_size = 18
theme_override_font_sizes/font_size = 130
text = "0"
horizontal_alignment = 1

; Deliberately NOT in a container: it is flown across the screen by hand, and a
; container would drag it back into place every frame.
