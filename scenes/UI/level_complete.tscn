; No dimming behind this any more, so the title carries its own outline --
; otherwise it disappears the moment the marble drifts across it.
[node name="Title" type="Label" parent="Panel"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 240.0
offset_bottom = 560.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/outline_size = 18
theme_override_font_sizes/font_size = 104
text = "LEVEL
COMPLETE"
horizontal_alignment = 1

; --- What the level gave up: the crowns, the score, and where the score came
; --- from. All three are stated rather than counted out. The score used to be
; --- tallied award by award, with a chip flying into a climbing total; the
; --- crowns are the thing worth watching land now, and a number counting itself
; --- up underneath them was two celebrations talking over each other.

; The crowns and the score, each on a card of its own, stacked down the middle.
;
; A column rather than three placed boxes: a card has to hug what is on it, and
; the breakdown under the score is between nought and five rows tall depending on
; how the level went. Every box here takes its height from its contents, and the
; column stacks whatever that comes to.
[node name="Stack" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 690.0
offset_bottom = 1600.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/separation = 34

[node name="CrownCard" type="PanelContainer" parent="Panel/Stack"]
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

; One slot per crown, filled by the script -- see level_complete.gd.
[node name="Crowns" type="HBoxContainer" parent="Panel/Stack/CrownCard"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 26

[node name="ScoreCard" type="PanelContainer" parent="Panel/Stack"]
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="ScoreStack" type="VBoxContainer" parent="Panel/Stack/ScoreCard"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

; The score, stated. Centred over the card rather than over the screen, which is
; the same line -- the card is centred too -- but leaves the record stamp
; measuring itself against a box that ends where the number does.
[node name="TotalValue" type="Label" parent="Panel/Stack/ScoreCard/ScoreStack"]
unique_name_in_owner = true
custom_minimum_size = Vector2(600, 150)
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.94901961, 0.72156863, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/outline_size = 18
theme_override_font_sizes/font_size = 130
text = "0"
horizontal_alignment = 1
vertical_alignment = 1

; What the score is made of, under the score itself. One row per award, in the
; order the goal ring worked them out -- the lumps of points first and whatever
; multiplied them last, which is the order they were applied in.
[node name="AwardList" type="VBoxContainer" parent="Panel/Stack/ScoreCard/ScoreStack"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

; A slot is a fixed box the badge inside can be thrown around in. The badge is
; NOT the box: a row lays its children out and would drag one back into place
; mid-jump.
[node name="CrownSlot" type="Control" parent="."]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(104, 104)
layout_mode = 1
anchors_preset = 0
offset_right = 104.0
offset_bottom = 104.0
mouse_filter = 2

[node name="Badge" type="TextureRect" parent="CrownSlot"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_crown_badge")
expand_mode = 1
stretch_mode = 5

; What a crown says when it lands. Cloned per crown and left up: they used to be
; one label reused, and the line for one crown was wiped out by the next.
;
; Laid across its own crown at a slant, so five of them can be on the panel at
; once and still be read -- parallel lines a crown apart never cross. Placed,
; slanted and coloured by the script, since all three depend on which crown it
; belongs to.
[node name="CheerTemplate" type="Label" parent="."]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(620, 86)
layout_mode = 1
anchors_preset = 0
offset_right = 620.0
offset_bottom = 86.0
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.78431374)
theme_override_constants/outline_size = 20
theme_override_font_sizes/font_size = 56
text = "Level Finished"
horizontal_alignment = 1
vertical_alignment = 1

; Stamped beside the finished total when the run beats the record, then left
; pulsing. Hidden until then, and placed by the script -- where "beside" is
; depends on how wide the number turned out, so it cannot be authored here.
;
; The box hugs its text -- the script pins it to that before measuring, so the
; offsets here are only what the editor draws -- and the type size is therefore
; what decides whether the stamp clears the number rather than landing on top of
; it. At 38 the box comes to 257 wide, which leaves the full gap beside a
; five-figure total, about the most the game pays out.
[node name="RecordStamp" type="PanelContainer" parent="Panel"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 0
offset_left = 787.0
offset_top = 865.0
offset_right = 1044.0
offset_bottom = 993.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_stamp")

[node name="RecordLabel" type="Label" parent="Panel/RecordStamp"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.84313726, 0.42745098, 1)
