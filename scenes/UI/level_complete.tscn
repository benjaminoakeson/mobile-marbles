; --- The tally: a running total, and one chip at a time flying into it ---

; Scaled by the script as it counts, so its pivot has to sit in the middle. The
; label spans the full width and centres its text, which keeps that pivot on the
; screen's centre line however many digits the number grows to.
[node name="TotalValue" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 700.0
offset_bottom = 860.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.94901961, 0.72156863, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/outline_size = 18
theme_override_font_sizes/font_size = 130
text = "0"
horizontal_alignment = 1

; Stamped beside the finished total when the run beats the record, then left
; pulsing. Hidden until then, and placed by the script -- where "beside" is
; depends on how wide the number turned out, so it cannot be authored here.
;
; The box hugs its text -- the script pins it to that before measuring, so the
; offsets here are only what the editor draws -- and the type size is therefore
; what decides whether the stamp clears the number rather than landing on top of
; it. At 38 the box comes to 257 wide, which leaves the full gap beside a
; five-figure total, about the most the game pays out.
[node name="RecordStamp" type="PanelContainer" parent="Panel"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 0
offset_left = 787.0
offset_top = 725.0
offset_right = 1044.0
offset_bottom = 853.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_stamp")

[node name="RecordLabel" type="Label" parent="Panel/RecordStamp"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.84313726, 0.42745098, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.70196080)
theme_override_constants/line_spacing = -4
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 38
text = "NEW
HIGHSCORE"
horizontal_alignment = 1
vertical_alignment = 1

