[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/stick_mode_button.gd" id="1_swap"]
[ext_resource type="Script" path="res://scripts/stick_mode_icon.gd" id="2_icon"]

; The same ground as the camera reset in the opposite corner: they are a pair,
; one control each side of the stick, and they should read as one. The radius is
; half the button's 160px box, which is what makes it a circle -- change one and
; the other has to follow.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_swap"]
bg_color = Color(0.09019608, 0.10980392, 0.12941177, 0.61176471)
corner_radius_top_left = 80
corner_radius_top_right = 80
corner_radius_bottom_right = 80
corner_radius_bottom_left = 80

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_swap_pressed"]
bg_color = Color(0.20392157, 0.23921569, 0.27450982, 0.78431374)
corner_radius_top_left = 80
corner_radius_top_right = 80
corner_radius_bottom_right = 80
corner_radius_bottom_left = 80

; In the group so the thumbstick lets presses through to it, the way the camera
; reset is -- the stick reads raw touches before the UI ever sees them, and its
; box reaches into this corner on a narrow screen. See `Thumbstick.BLOCKER_GROUP`.
[node name="StickModeButton" type="Button" groups=["blocks_thumbstick"]]
custom_minimum_size = Vector2(160, 160)
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = -208.0
offset_right = 208.0
offset_bottom = -48.0
grow_vertical = 0
theme_override_styles/normal = SubResource("StyleBoxFlat_swap")
theme_override_styles/hover = SubResource("StyleBoxFlat_swap")
theme_override_styles/pressed = SubResource("StyleBoxFlat_swap_pressed")
theme_override_styles/focus = SubResource("StyleBoxFlat_swap")
script = ExtResource("1_swap")

[node name="Icon" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_icon")
