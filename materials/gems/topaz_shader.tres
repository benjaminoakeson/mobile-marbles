[gd_resource type="ShaderMaterial" format=3 uid="uid://cv753ugf5x3u4"]

[sub_resource type="Shader" id="Shader_0tg5t"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

// One shader for every gem: a clean, brilliant-cut stone. Set `gem_colour` per
// material and leave the rest alone -- an emerald and a ruby differ only in
// that one swatch.
//
// What makes a diamond read as a diamond is not the colour, it is three things
// happening at the edges: a mirror-bright surface at glancing angles, a jumble
// of bright shapes shifting about inside as it turns, and a rainbow fringe on
// those shapes. All three are here, and none of them need the screen texture --
// this is the mobile renderer, so reading the framebuffer is off the table (the
// same reason the marble shader walks its ray straight).
//
// There is no real geometry inside the stone and there does not need to be. The
// view ray is refracted at the surface and then bounced off IMAGINARY facets:
// the direction is chopped into cells, each cell gets its own fixed mirror, and
// each bounce is a lookup into a painted-on surrounding light. The cells are
// measured in the gem's own space, so the pattern is welded to the stone and
// sweeps round with it as it spins -- which is the whole trick. A pattern fixed
// to the screen looks like a texture; one fixed to the stone looks like a cut.

group_uniforms Colour;
// The one knob per gem. Everything below is shared.
uniform vec4 gem_colour : source_color = vec4(0.25, 0.9, 0.55, 1.0);
// How hard the colour soaks up light along the ray's run through the stone.
// Low is a pale, watery stone; high is a deep, saturated one.
uniform float absorption : hint_range(0.0, 8.0) = 2.5;
uniform float inner_brightness : hint_range(0.0, 4.0) = 1.6;
// Carried into EMISSION so the gem still reads as a pickup in a dim level
// rather than going the colour of whatever light happens to be nearby.
uniform float inner_glow : hint_range(0.0, 2.0) = 0.35;

group_uniforms Cut;
// Diamond is about 2.42. Lower it towards 1.5 for glass, raise it for a stone
// that bends the light hard enough to fold the inside over on itself.
uniform float ior : hint_range(1.0, 3.0) = 2.42;
// The rainbow fringe. Red bends least and blue most, so the three channels are
// gathered along slightly different rays.
uniform float dispersion : hint_range(0.0, 1.0) = 0.4;
// How many imaginary facets the inside is chopped into. More means a finer,
// busier sparkle.
uniform float facet_count : hint_range(1.0, 24.0) = 6.0;
// How far each bounce turns onto its facet. A full reflection off a random
// mirror scatters the ray so hard the facets stop reading as flats.
uniform float facet_bite : hint_range(0.0, 1.0) = 0.75;
// How unevenly the facets catch the light. At zero every one of them gathers
// the same amount and the inside goes to mush; this is what gives a cut stone
// its scatter of bright and near-black flats.
uniform float facet_contrast : hint_range(0.0, 1.0) = 0.6;
// Pulls the shading normal onto the true face of each triangle, so the cut
// stays crisp however the mesh's own normals were exported.
uniform float facet_sharpness : hint_range(0.0, 1.0) = 1.0;
// Half the width of the stone, used to measure how far a ray runs through it.
uniform float gem_radius = 0.22;

group_uniforms Surface;
uniform float reflectivity : hint_range(0.0, 2.0) = 1.0;
uniform float fresnel_power : hint_range(0.5, 8.0) = 4.0;
uniform float surface_roughness : hint_range(0.0, 0.5) = 0.02;
// How solid the body of the stone is. The edges are pulled to solid regardless
// by `edge_solidity`, which is what stops a see-through gem looking like a
// decal.
uniform float body_alpha : hint_range(0.0, 1.0) = 0.85;
uniform float edge_solidity : hint_range(0.0, 1.0) = 1.0;

group_uniforms Sparkle;
uniform vec4 sparkle_colour : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float sparkle_strength : hint_range(0.0, 4.0) = 1.0;
uniform float sparkle_sharpness : hint_range(4.0, 256.0) = 28.0;

group_uniforms Surroundings;
// A painted-on sky, not the real one. Nothing here reads the scene's
// environment -- a stone with a plausible world reflected in it beats one with
// the true world reflected in it, and this costs a handful of instructions.
uniform vec3 key_direction = vec3(0.35, 0.9, 0.4);
uniform vec4 sky_colour : source_color = vec4(0.55, 0.72, 1.0, 1.0);
uniform vec4 horizon_colour : source_color = vec4(1.0, 0.97, 0.92, 1.0);
uniform vec4 ground_colour : source_color = vec4(0.16, 0.15, 0.14, 1.0);
uniform float key_energy : hint_range(0.0, 8.0) = 2.0;
uniform float key_sharpness : hint_range(4.0, 512.0) = 90.0;

const int BOUNCES = 2;

varying vec3 obj_position;
varying vec3 obj_normal;
varying vec3 obj_view;


vec3 hash33(vec3 p) {
	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
	p += dot(p, p.yxz + 33.33);
	return fract((p.xxy + p.yxx) * p.zyx);
}


// The light the stone sits in: sky above, a bright band at the horizon, dark
// ground below, and one hard sun to throw glints off.
vec3 surroundings(vec3 world_dir) {
	float height = world_dir.y;
	vec3 light = mix(horizon_colour.rgb, sky_colour.rgb, smoothstep(0.0, 0.6, height));
	light = mix(light, ground_colour.rgb, smoothstep(0.0, -0.45, height));

	float key = pow(max(dot(world_dir, normalize(key_direction)), 0.0), key_sharpness);
	return light + key * key_energy;
}


// Past the critical angle refract() gives up and returns zero. That is real:
// it is the total internal reflection a stone shows at its shallow edges, and
// bouncing the ray back inside is exactly what happens there.
vec3 bend(vec3 incoming, vec3 n, float eta) {
	vec3 bent = refract(incoming, n, eta);
	return length(bent) < 0.001 ? reflect(incoming, n) : normalize(bent);
}


// Walk a ray around inside the stone, off the imaginary facets described at the
// top, gathering light at every bounce. `glint` comes back as how squarely one
// of those facets lined up with the key light -- that is the flash.
vec3 gather_inside(vec3 dir, mat3 to_world, out float glint) {
	vec3 gathered = vec3(0.0);
	float weight = 1.0;
	float total = 0.0;
	glint = 0.0;

	vec3 d = dir;
	for (int i = 0; i < BOUNCES; i++) {
		vec3 cell = floor(d * facet_count);
		vec3 rnd = hash33(cell);
		vec3 mirror = normalize(rnd * 2.0 - 1.0);
		d = normalize(mix(d, reflect(d, mirror), facet_bite));

		vec3 world_d = normalize(to_world * d);
		float catch_light = mix(1.0 - facet_contrast, 1.0 + facet_contrast, rnd.y);
		gathered += surroundings(world_d) * catch_light * weight;
		total += weight;

		// A facet flashes when it happens to line up with the key light. Only
		// some of them ever do -- a stone where every flat flashes at once is a
		// disco ball, not a diamond.
		float aim = max(dot(world_d, normalize(key_direction)), 0.0);
		glint = max(glint, pow(aim, sparkle_sharpness) * smoothstep(0.45, 1.0, rnd.x));

		// Each bounce loses light, so the first facet the eye looks through
		// counts for most of what it sees.
		weight *= 0.6;
	}

	return gathered / max(total, 0.001);
}


void vertex() {
	obj_position = VERTEX;
	obj_normal = NORMAL;

	// The ray from the eye to this vertex in the gem's own space, so everything
	// below is indifferent to where the gem is or which way it is facing.
	vec3 eye = (inverse(MODEL_MATRIX) * vec4(CAMERA_POSITION_WORLD, 1.0)).xyz;
	obj_view = VERTEX - eye;
}


void fragment() {
	// The true face of the triangle, taken from how the surface point changes
	// across the pixel. Rebuilding it this way means the cut stays hard-edged
	// even where the mesh carries smoothed normals.
	vec3 n_view = normalize(NORMAL);
	vec3 face_view = normalize(cross(dFdx(VERTEX), dFdy(VERTEX)));
	// Which way the cross product points depends on winding, so it is turned to
	// agree with the mesh's own normal rather than trusted outright.
	face_view *= sign(dot(face_view, n_view));
	vec3 shade_n = normalize(mix(n_view, face_view, facet_sharpness));

	// The same face, in the gem's space, for the ray work below.
	vec3 n_obj = normalize(obj_normal);
	vec3 face_obj = normalize(cross(dFdx(obj_position), dFdy(obj_position)));
	face_obj *= sign(dot(face_obj, n_obj));
	n_obj = normalize(mix(n_obj, face_obj, facet_sharpness));

	vec3 v_obj = normalize(obj_view);
	mat3 to_world = mat3(MODEL_MATRIX);

	// How far the ray runs through the stone, as a fraction of its full width,
	// measured across the bounding sphere. Thick through the middle, thin at
	// the edges -- this is what stops a tinted gem reading as flat paint.
	float b = dot(obj_position, v_obj);
	float c = dot(obj_position, obj_position) - gem_radius * gem_radius;
	float chord = max(-b + sqrt(max(b * b - c, 0.0)), 0.0) / max(gem_radius * 2.0, 0.001);

	float eta = 1.0 / max(ior, 1.0);
	vec3 inner;
	float glint;

	// Branching on a uniform is the same answer for every pixel, so the whole
	// draw takes one side or the other and the split costs nothing. Worth it:
	// dispersion triples the work inside.
	if (dispersion > 0.001) {
		float spread = dispersion * 0.06;
		float red_glint;
		float green_glint;
		float blue_glint;
		vec3 red = gather_inside(bend(v_obj, n_obj, eta * (1.0 + spread)), to_world, red_glint);
		vec3 green = gather_inside(bend(v_obj, n_obj, eta), to_world, green_glint);
		vec3 blue = gather_inside(bend(v_obj, n_obj, eta * (1.0 - spread)), to_world, blue_glint);
		inner = vec3(red.r, green.g, blue.b);
		glint = max(green_glint, max(red_glint, blue_glint));
	} else {
		inner = gather_inside(bend(v_obj, n_obj, eta), to_world, glint);
	}

	// Beer-Lambert: everything but the gem's own colour is soaked up along the
	// run, and the longer the run the less of it survives.
	inner *= exp(-(vec3(1.0) - gem_colour.rgb) * absorption * chord);
	inner *= inner_brightness;

	// What the polished surface throws back. Glancing angles turn a stone into
	// a mirror, and with no refraction of the real scene this and the glints
	// are what sell it as glass.
	mat3 view_to_world = mat3(INV_VIEW_MATRIX);
	vec3 world_n = normalize(view_to_world * shade_n);
	vec3 world_v = normalize(view_to_world * normalize(VIEW));
	vec3 sheen = surroundings(reflect(-world_v, world_n));

	float fresnel = pow(1.0 - clamp(dot(shade_n, normalize(VIEW)), 0.0, 1.0), fresnel_power);
	float mirror = clamp(mix(0.15, 1.0, fresnel) * reflectivity, 0.0, 1.0);

	vec3 body = mix(inner, sheen, mirror);
	body += sparkle_colour.rgb * glint * sparkle_strength;

	ALBEDO = body;
	EMISSION = body * inner_glow;
	ALPHA = clamp(mix(body_alpha, 1.0, fresnel * edge_solidity), 0.0, 1.0);

	METALLIC = 0.0;
	SPECULAR = 1.0;
	ROUGHNESS = surface_roughness;
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_0tg5t")
shader_parameter/gem_colour = Color(0.8841397, 0.6561559, 0.185031, 1)
shader_parameter/absorption = 6.698000318155
shader_parameter/inner_brightness = 4.0
shader_parameter/inner_glow = 0.35
shader_parameter/ior = 3.0
shader_parameter/dispersion = 0.770000036575
shader_parameter/facet_count = 24.0
shader_parameter/facet_bite = 1.0
shader_parameter/facet_contrast = 1.0
shader_parameter/facet_sharpness = 1.0
shader_parameter/gem_radius = 0.22
shader_parameter/reflectivity = 0.050000002375
shader_parameter/fresnel_power = 4.0
shader_parameter/surface_roughness = 0.0050000002375
shader_parameter/body_alpha = 0.85
shader_parameter/edge_solidity = 1.0
shader_parameter/sparkle_colour = Color(1, 1, 1, 1)
shader_parameter/sparkle_strength = 1.0
shader_parameter/sparkle_sharpness = 28.0
shader_parameter/key_direction = Vector3(0.35, 0.9, 0.4)
shader_parameter/sky_colour = Color(0.55, 0.72, 1, 1)
shader_parameter/horizon_colour = Color(1, 0.97, 0.92, 1)
shader_parameter/ground_colour = Color(0.16, 0.15, 0.14, 1)
shader_parameter/key_energy = 2.0
shader_parameter/key_sharpness = 90.0
